        "out_csr": {"offsets": [0, 2, 2], "neighbors": [0, 1]},
        "in_csr": {"offsets": [0, 0, 2], "neighbors": [0, 1]},
        "adjacency": [[["r", 2], ["r", 9]], [["r", 2], ["r", 9]]]
      }
    },
    {
      "name": "parallel-different",
      "purpose": "Relationship ordering precedes edge ID for parallel edges of different types.",
      "nodes": [{"id": 10, "labels": []}, {"id": 20, "labels": []}],
      "edges": [
        {"id": 1, "source": 10, "target": 20, "relationship": "z"},
        {"id": 8, "source": 10, "target": 20, "relationship": "a"},
        {"id": 3, "source": 10, "target": 20, "relationship": "a"}
      ],
      "clock": 0,
      "queries": [{"node": 10, "direction": "both", "relationship": null, "after": null, "limit": 10}],
      "expected": {
        "node_map": [{"id": 10, "ordinal": 0, "labels": []}, {"id": 20, "ordinal": 1, "labels": []}],
        "relationships": ["a", "z"], "labels": [],
        "edge_table": [
          {"id": 1, "ordinal": 0, "source": 0, "target": 1, "relationship": 1},
          {"id": 3, "ordinal": 1, "source": 0, "target": 1, "relationship": 0},
          {"id": 8, "ordinal": 2, "source": 0, "target": 1, "relationship": 0}
        ],
        "out_csr": {"offsets": [0, 3, 3], "neighbors": [1, 2, 0]},
        "in_csr": {"offsets": [0, 0, 3], "neighbors": [1, 2, 0]},
        "adjacency": [[["a", 3], ["a", 8], ["z", 1]]]
      }
    },
    {
      "name": "self-loops",
      "purpose": "Self-loop in each CSR, once in Both; incoming and outgoing nonloops merge by type.",
