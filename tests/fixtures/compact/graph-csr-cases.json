          {"id": 8, "ordinal": 2, "source": 0, "target": 0, "relationship": 0}
        ],
        "out_csr": {"offsets": [0, 2, 3], "neighbors": [0, 2, 1]},
        "in_csr": {"offsets": [0, 2, 3], "neighbors": [2, 1, 0]},
        "adjacency": [
          [["r", 1], ["r", 8]], [["r", 8], ["s", 2]],
          [["r", 1], ["r", 8], ["s", 2]], [["r", 8]]
        ]
      }
    },
    {
      "name": "unicode-relationships",
      "purpose": "UTF-8 bytewise order, including combining versus composed strings and supplementary codepoints.",
