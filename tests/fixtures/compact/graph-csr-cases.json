      "edges": [
        {"id": 8, "source": 5, "target": 5, "relationship": "r"},
        {"id": 1, "source": 5, "target": 9, "relationship": "r"},
        {"id": 2, "source": 9, "target": 5, "relationship": "s"}
      ],
      "clock": 0,
      "queries": [
        {"node": 5, "direction": "out", "relationship": null, "after": null, "limit": 10},
        {"node": 5, "direction": "in", "relationship": null, "after": null, "limit": 10},
        {"node": 5, "direction": "both", "relationship": null, "after": null, "limit": 10},
        {"node": 5, "direction": "both", "relationship": ["r"],
         "after": {"relationship": "r", "edge": 1}, "limit": 1}
      ],
      "expected": {
        "node_map": [{"id": 5, "ordinal": 0, "labels": []}, {"id": 9, "ordinal": 1, "labels": []}],
        "relationships": ["r", "s"], "labels": [],
        "edge_table": [
