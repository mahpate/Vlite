      "expected": {
        "declarations": [{"kind": "Label", "name": "L", "description": "", "properties": [
          {"name": "p", "type": "Integer", "required": true, "unique": false, "index": null}
        ]}], "conforms": false,
        "violations": [
          {"entity": "node", "id": 0, "element": "L", "rule": "required", "property": "p"},
          {"entity": "node", "id": 1, "element": "L", "rule": "type", "property": "p"}
        ], "results": []
      }
