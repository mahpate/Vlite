{
  "schema": "vlite.compact-graph-logical",
  "version": 1,
  "cases": [
    {
      "name": "empty",
      "purpose": "No physical entities; empty CSR still has its zero sentinel.",
      "nodes": [], "edges": [], "clock": 0,
      "queries": [{"node": 0, "direction": "both", "relationship": null, "after": null, "limit": 10}],
      "expected": {
        "node_map": [], "relationships": [], "labels": [], "edge_table": [],
        "out_csr": {"offsets": [0], "neighbors": []},
        "in_csr": {"offsets": [0], "neighbors": []}, "adjacency": [[]]
      }
    },
    {
      "name": "single-node",
      "purpose": "An isolated sparse public ID, explicit null deadline, and a missing query node.",
      "nodes": [{"id": 42, "labels": ["A"], "deadline": null}], "edges": [], "clock": 0,
      "queries": [
        {"node": 42, "direction": "out", "relationship": null, "after": null, "limit": 10},
        {"node": 43, "direction": "both", "relationship": null, "after": null, "limit": 10}
