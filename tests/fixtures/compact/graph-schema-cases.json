          {"kind": "Label", "name": "B", "description": "", "properties": [{"name": "p", "type": "String", "required": false, "unique": true, "index": null}]}
        ], "conforms": true, "violations": [], "results": [{"ids": [2], "index": "Exact"}]
      }
