        "nodes": [
          {"id": 1, "labels": ["L"], "properties": [{"name": "p", "type": "GeoPoint", "latitude_bits": "8000000000000000", "longitude_bits": "0000000000000000"}]},
          {"id": 0, "labels": ["L"], "properties": [{"name": "p", "type": "GeoPoint", "latitude_bits": "0000000000000000", "longitude_bits": "8000000000000000"}]}
        ], "edges": [], "queries": []
      },
      "expected": {
        "declarations": [{"kind": "Label", "name": "L", "description": "", "properties": [
          {"name": "p", "type": "GeoPoint", "required": false, "unique": true, "index": null}
        ]}], "conforms": false,
        "violations": [
          {"entity": "node", "id": 0, "element": "L", "rule": "unique", "property": "p"},
          {"entity": "node", "id": 1, "element": "L", "rule": "unique", "property": "p"}
        ], "results": []
      }
    },
    {
      "name": "optional-unique-is-label-scoped",
      "purpose": "Missing values do not collide; the same value on another label or an undeclared label does not violate uniqueness.",
      "input": {
        "declarations": [
          {"kind": "Label", "name": "A", "description": "", "properties": [{"name": "p", "type": "String", "required": false, "unique": true, "index": null}]},
          {"kind": "Label", "name": "B", "description": "", "properties": [{"name": "p", "type": "String", "required": false, "unique": true, "index": null}]}
        ],
        "nodes": [
          {"id": 4, "labels": ["Other"], "properties": [{"name": "p", "type": "String", "value": "same"}]},
