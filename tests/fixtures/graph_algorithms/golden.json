{
  "schema": "vlite.graph-algorithm-golden",
  "version": 1,
  "contract": {
    "description": "Independent tiny mathematical reference inputs and expected outputs for future Rust tests; no engine algorithms are implemented by these fixtures. Node/edge id is the stable numeric ID used for comparisons; public_id is an opaque public identifier. Every edge supplies an explicit nonnegative weight, used only when weight_policy is explicit. Scope is a complete induced local projection with no work/output truncation.",
    "score_abs_tolerance": 1e-8,
    "mass_abs_tolerance": 1e-12,
    "residual_abs_tolerance": 1e-12,
    "ordering": "Output rows and scope ID sets ascend by numeric ID, never by score or public ID. Path arrays preserve traversal order. Path candidates compare exact f64 cost, hops, then numeric edge-ID tuple. Betweenness selected/completed sources preserve SplitMix64-v1 sampling order, NOT node-ID order.",
    "bounds": "1..6 nodes, at most 12 physical edges, H=1..4; walks of length 0..H and simple paths are exhaustively enumerated, not benchmarked. Scope filters are all-label conjunction and explicit relationship inclusion (or any). Seeds are deduplicated; out/in/both arcs are projected before induction.",
    "pagerank_reference": "stationary_scores solve (I-d*T^transpose)r=(1-d)p with exact rational arithmetic, including dangling redistribution to p. They are NOT an iterative result or a claimed iteration count. Future Rust tests run the supplied tolerance=1e-10 and max_iterations=100, require converged=true, completed-step L1 change <= tolerance and unit mass within 1e-12, and compare the last full vector to stationary_scores within 1e-8. fixed_point_l1_residual describes the stationary reference only.",
    "exclusions": "No Rust engine coverage, invalid-input API assertions, TTL/storage/authorization, resource exhaustion, partial sweeps/sources, partial sampling, or cross-platform bitwise equality claims. No edge-property condition filters are modeled."
  },
  "cases": [
    {
      "name": "weighted_diamond",
      "algorithm": "weighted_shortest_path",
      "purpose": "Two-hop cost 1+1 beats the direct cost 3.",
