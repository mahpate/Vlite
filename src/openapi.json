{
  "openapi": "3.1.0",
  "info": {
    "title": "VLite REST API",
    "version": "0.1.2",
    "description": "Experimental API for one exclusively owned database. Bearer authentication is required except explicit loopback-only development mode. Optional distinct read-only credentials permit GET/HEAD outside /v1/admin/ and POST /v1/search in exact or approximate_ready mode only; other requests require admin (403 otherwise). /health and static dashboard assets are public. Terminate TLS at a trusted proxy; the binary serves plain HTTP. No CORS, automatic repair or retries. X-Request-ID and Cache-Control: no-store are included. IDs and administrative seeds use decimal strings; payloads use padded standard base64. JSON is limited to 8 MiB and 16 in-flight requests/workers. Successful writes are synced. Disconnects and commit_indeterminate errors do not prove writes failed; never blindly retry. Backups require VLITE_ADMIN_DIR; restore selection takes effect only on restart and never replaces the live owner. Token reload reads only configured files. See docs/CONSOLE-ADMIN.md for semantics, bounds and durability limitations. Protected operations may return 401, 403, 422 or 503 with the Error schema."
  },
  "security": [{"BearerAuth": []}],
  "servers": [{"url": "http://127.0.0.1:8080"}],
  "paths": {
    "/v1/capabilities": {
      "get": {"summary":"Authenticated version, role and compatibility diagnostics","responses":{"200":{"description":"Capability flags reflect server configuration","content":{"application/json":{"schema":{"type":"object","required":["version","api_version","role","features","routes"],"properties":{"version":{"type":"string"},"api_version":{"const":1},"role":{"enum":["admin","read_only"]},"features":{"type":"object","properties":{"read_only":{"type":"boolean"},"tokens_reload":{"type":"boolean"},"audit":{"type":"boolean"},"background_rebuild":{"type":"boolean"},"maintenance":{"type":"boolean"},"backup_restore":{"type":"boolean"}}},"routes":{"type":"array","items":{"type":"string"}}}}}}}}}
    },
    "/v1/admin/tokens": {
      "get":{"summary":"Admin only: nonsecret credential configuration","responses":{"200":{"description":"No token values or paths","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TokenStatus"}}}}}}
    },
    "/v1/admin/tokens/reload": {
      "post":{"summary":"Admin only: atomically reload configured token files","description":"Invalid files leave both credentials unchanged. Empty read-only file revokes that role. In-flight requests may finish. Environment credentials are not reread. Request bodies cannot supply credentials or paths.","responses":{"200":{"description":"Reloaded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TokenStatus"}}}},"409":{"description":"No token files configured"},"422":{"description":"Invalid or unavailable token file"}}}
    },
    "/v1/admin/tokens/revoke-read-only": {
      "post":{"summary":"Admin only: revoke in-memory read-only credential","description":"Persist revocation by emptying its configured file before another reload/restart.","responses":{"200":{"description":"Revoked","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TokenStatus"}}}}}}
    },
    "/v1/admin/audit": {
      "get":{"summary":"Admin only: bounded sanitized process-local audit","description":"No IDs, queries, bodies, content, credentials or arbitrary paths. Not a durable compliance log; resets at restart.","responses":{"200":{"description":"Most recent 256 completed requests","content":{"application/json":{"schema":{"type":"object","properties":{"capacity":{"const":256},"items":{"type":"array","maxItems":256,"items":{"type":"object","properties":{"request_id":{"type":"string"},"method":{"type":"string"},"route":{"type":"string","description":"Matched template or unmatched"},"status":{"type":"integer"},"role":{"enum":["admin","read_only",null]},"duration_ns":{"type":"integer"},"timestamp_unix_ms":{"type":"integer"}}}}}}}}}}}
    },
    "/v1/index/hnsw/rebuild": {
      "get":{"summary":"Observe background job without polling/publication","responses":{"200":{"description":"Policy and observational status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MaintenanceEnvelope"}}}}}},
      "post":{"summary":"Admin only: start one bounded background rebuild","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RebuildRequest"}}}},"responses":{"202":{"description":"Started","content":{"application/json":{"schema":{"type":"object","properties":{"outcome":{"const":"running"}}}}}},"409":{"description":"Pending rebuild"},"422":{"description":"Invalid config/limits/metric or oversized snapshot"}}}
    },
    "/v1/index/hnsw/rebuild/poll": {
      "post":{"summary":"Admin only: nonblocking reap/publication of completed job","description":"Terminal outcome is consumed; next poll returns idle. No hidden polling.","responses":{"200":{"description":"Outcome","content":{"application/json":{"schema":{"type":"object","properties":{"outcome":{"$ref":"#/components/schemas/RebuildOutcome"}}}}}}}}
    },
    "/v1/index/hnsw/rebuild/cancel": {
      "post":{"summary":"Admin only: cooperative cancellation preserving active graph","responses":{"200":{"description":"Cancellation requested; poll to reap","content":{"application/json":{"schema":{"type":"object","properties":{"cancelled":{"type":"boolean"}}}}}}}}
    },
    "/v1/index/hnsw/maintenance": {
      "get":{"summary":"Observe policy and status without publication","responses":{"200":{"description":"Policy and status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MaintenanceEnvelope"}}}}}},
      "put":{"summary":"Admin only: replace process-local policy; omitted values default","description":"No automatic timers, retries, or restart persistence.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MaintenancePolicy"}}}},"responses":{"200":{"description":"Validated policy and status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MaintenanceEnvelope"}}}},"422":{"description":"Invalid policy"}}}
    },
    "/v1/index/hnsw/maintenance/tick": {
      "post":{"summary":"Admin only: explicit poll/publish and conditional start","responses":{"200":{"description":"Tick result","content":{"application/json":{"schema":{"type":"object","properties":{"outcome":{"$ref":"#/components/schemas/RebuildOutcome"},"started":{"type":"boolean"},"status":{"$ref":"#/components/schemas/MaintenanceStatus"}}}}}},"409":{"description":"Mismatched pending job"}}}
    },
    "/v1/admin/backups": {
      "get":{"summary":"Admin only: list at most 1000 generated regular files","responses":{"200":{"description":"No filesystem paths","content":{"application/json":{"schema":{"type":"object","properties":{"enabled":{"type":"boolean"},"restart_required":{"const":true},"items":{"type":"array","maxItems":1000,"items":{"type":"object","properties":{"name":{"type":"string"},"kind":{"enum":["backup","restore"]},"bytes":{"type":"integer"}}}}}}}}}}},
      "post":{"summary":"Admin only: serialize owner, sync/validate generated backup","description":"Requires private VLITE_ADMIN_DIR. Copy blocks database work. No arbitrary path or overwrite.","responses":{"201":{"description":"New snapshot","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SnapshotResult"}}}},"409":{"description":"Admin directory disabled"}}}
    },
    "/v1/admin/restores": {
      "post":{"summary":"Admin only: validate backup into new generated restored copy","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["backup"],"properties":{"backup":{"type":"string","maxLength":96}}}}}},"responses":{"201":{"description":"Restored copy; live owner unchanged","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SnapshotResult"}}}},"409":{"description":"Admin directory disabled"},"422":{"description":"Invalid generated name or nonregular file"}}}
    },
    "/v1/admin/restores/select": {
      "post":{"summary":"Admin only: select validated restored copy for next startup","description":"No live replacement. Persistent next-startup marker selects generated copy when VLITE_ADMIN_DIR is configured. Invalid selection fails startup. Remove marker offline to return to positional database.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","maxLength":96}}}}}},"responses":{"200":{"description":"Restart required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SnapshotResult"}}}},"409":{"description":"Admin directory disabled"}}}
    },
    "/dashboard/console-tools.js": {
      "get":{"security":[],"summary":"Public console tools; no credentials","responses":{"200":{"description":"Bundled JavaScript"}}}
    },
    "/dashboard": {
      "get": {"security": [], "summary": "Public static testing dashboard; all database requests require bearer authentication", "responses": {"200": {"description": "Bundled HTML with same-origin script/style assets, restrictive CSP and no-store", "content": {"text/html": {"schema": {"type": "string"}}}}}}
    },
    "/dashboard/app.js": {
      "get": {"security": [], "summary": "Public static dashboard JavaScript; no credentials", "responses": {"200": {"description": "Bundled script", "content": {"text/javascript": {"schema": {"type": "string"}}}}}}
    },
    "/dashboard/style.css": {
      "get": {"security": [], "summary": "Public static dashboard stylesheet", "responses": {"200": {"description": "Bundled stylesheet", "content": {"text/css": {"schema": {"type": "string"}}}}}}
    },
    "/health": {
      "get": {
        "security": [],
        "summary": "Process liveness, independent of database health",
        "responses": {"200": {"description": "Alive", "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"const": "ok"}}, "required": ["status"]}}}}}
      }
    },
    "/metrics": {
      "get": {
        "summary": "Authenticated process-local JSON metrics snapshot",
        "description": "Counters reset at restart; request duration totals cover completed middleware responses and exclude streaming body transfer. HNSW rebuild counters include explicit builds and lazy builds. HNSW timing includes explicit build duration or build plus the triggering query, not isolated build time for lazy queries. Metrics reads queue behind database work and fail 503 if busy or closed. Poisoned owners still expose failure counters with database_healthy=false and null database gauges. Live records, file bytes and buffer usage are gauges; other numeric values are cumulative. The current metrics request is counted but not yet timed.",
        "responses": {
          "200": {"description": "Metrics snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Metrics"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Database can serve reads; poisoned/closed handles fail",
        "responses": {
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "200": {"description": "Ready", "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"const": "ready"}}, "required": ["status"]}}}},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/database": {
      "get": {
        "summary": "Database dimensions, format and live record count",
        "responses": {
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "200": {"description": "Database information", "content": {"application/json": {"schema": {"type": "object", "required": ["dimensions", "format_version", "records"], "properties": {"dimensions": {"type": "integer"}, "format_version": {"type": "integer"}, "records": {"type": "integer"}}}}}},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/vectors": {
      "get": {
        "summary": "Bounded live-page listing of vector IDs and typed metadata only",
        "description": "Ascending numeric u64 order. after is an exclusive ID bound, not an opaque snapshot token and need not exist. Omitting after starts at the beginning, including ID 0. Concurrent writes between requests can change membership/metadata; inserts at or below the cursor will not appear in subsequent pages. No stable snapshot or total count is promised. A page is capped at limit records and 1 MiB serialized JSON, whichever occurs first; it can contain fewer than limit even when more data exists. Use next_after until null. Vectors and payloads are deliberately omitted. Empty/end pages have items=[] and next_after=null. Listing does not build an index or modify storage.",
        "parameters": [
          {"name": "after", "in": "query", "schema": {"$ref": "#/components/schemas/Id"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}}
        ],
        "responses": {
          "200": {"description": "Bounded page", "content": {"application/json": {"schema": {"type": "object", "required": ["items", "next_after"], "properties": {
            "items": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["id", "metadata"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "metadata": {"$ref": "#/components/schemas/Metadata"}}}},
            "next_after": {"oneOf": [{"$ref": "#/components/schemas/Id"}, {"type": "null"}]}
          }}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/vectors/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Id"}}],
      "get": {
        "summary": "Read one vector, opaque payload and typed metadata",
        "responses": {
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "200": {"description": "Record", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Record"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      },
      "put": {
        "summary": "Durably replace vector, payload and entire metadata map; omitted metadata clears it",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Put"}}}},
        "responses": {
          "204": {"description": "Durably committed"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "409": {"$ref": "#/components/responses/Upgrade"},
          "413": {"$ref": "#/components/responses/TooLarge"},
          "415": {"$ref": "#/components/responses/MediaType"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      },
      "delete": {
        "summary": "Durably delete; missing ID is a successful no-op",
        "responses": {
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "200": {"description": "Deletion result", "content": {"application/json": {"schema": {"type": "object", "required": ["deleted"], "properties": {"deleted": {"type": "boolean"}}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/batches": {
      "post": {
        "summary": "Durably apply all operations atomically in order",
        "description": "At most 4096 operations and 16 MiB encoded engine body, additionally bounded by the 8 MiB HTTP JSON limit. Empty batch is a no-op. Duplicate IDs execute in order. Any invalid operation rejects the entire batch before storage mutation.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["operations"], "properties": {"operations": {"type": "array", "maxItems": 4096, "items": {"oneOf": [{"$ref": "#/components/schemas/BatchPut"}, {"$ref": "#/components/schemas/BatchDelete"}]}}}}}}},
        "responses": {
          "204": {"description": "Entire batch durably committed, or empty no-op"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "409": {"$ref": "#/components/responses/Upgrade"},
          "413": {"$ref": "#/components/responses/TooLarge"},
          "415": {"$ref": "#/components/responses/MediaType"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/index/hnsw": {
      "get": {
        "summary": "Read readiness and mutation-buffer usage without building",
        "description": "Point-in-time status for the currently retained HNSW configuration, or defaults when absent; not a readiness reservation or latency guarantee. ready=true may include buffered writes; search config and metric must match. One index is retained. Reopen/overflow lose readiness. Serialized owner work may queue. Does not build, poll, publish, or increment rebuild counters.",
        "responses": {
          "200": {"description": "Index status", "content": {"application/json": {"schema": {"type": "object", "required": ["ready", "metric", "buffered_ids", "buffer_vector_bytes", "max_buffer_ids", "max_buffer_vector_bytes", "config"], "properties": {
            "ready": {"type": "boolean"},
            "metric": {"enum": ["squared_l2", "cosine", null]},
            "buffered_ids": {"type": "integer", "minimum": 0, "maximum": 256},
            "buffer_vector_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
            "max_buffer_ids": {"const": 256}, "max_buffer_vector_bytes": {"const": 8388608},
            "config": {"$ref":"#/components/schemas/IndexConfig"}
          }}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      },
      "post": {
        "summary": "Explicitly rebuild the in-memory HNSW index",
        "description": "Admin only. Accepts {} or explicit metric/config. Synchronously replaces the one index from current committed records and clears its buffer. Config defaults to m=16, ef_construction=100, seed=42. No database bytes change. Owner work queues behind this build; a disconnect does not cancel it. Nothing is persisted. Prefer explicit bounded background rebuild endpoints for large datasets.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"metric": {"type": "string", "enum": ["squared_l2", "cosine"], "default": "squared_l2"},"config":{"$ref":"#/components/schemas/IndexConfig"}}}}}},
        "responses": {
          "204": {"description": "Index built from committed live records"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "413": {"$ref": "#/components/responses/TooLarge"},
          "415": {"$ref": "#/components/responses/MediaType"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/search": {
      "post": {
        "summary": "Exact multi-metric search or squared-L2/cosine approximate search",
        "description": "All modes order by distance then numeric ID. Exact mode filters first; optional filter is an AND array of at most 64 strict-type conditions. Cosine rejects zero-norm queries even for k=0 and excludes zero-norm records. Approximate modes support squared_l2/cosine only and reject non-null filters. Optional config selects HNSW parameters (defaults 16/100/42). Graph buffer is capped at 256 IDs and 8 MiB vector bytes; overflow discards the graph. Lazy approximate synchronously rebuilds missing/config-mismatched graphs and is admin-only (read-only returns 403). approximate_ready never builds: a missing/config/metric mismatch returns 409; empty/k=0 queries validate but need no graph. No fallback; ANN recall/count not guaranteed. ef_search defaults to max(100,min(k,live count)), must be at least min(k,live count), and is rejected in exact mode. Internal width may include 256 extra buffered IDs. Distances accumulate in f64 and are exact for returned candidates; payloads/metadata are fetched separately.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type":"object","additionalProperties":false,"required":["vector","k"],"properties":{"vector":{"$ref":"#/components/schemas/Vector"},"k":{"type":"integer","minimum":0,"maximum":10000},"metric":{"enum":["squared_l2","cosine","inner_product"],"default":"squared_l2"},"mode":{"enum":["exact","approximate","approximate_ready"],"default":"exact"},"config":{"$ref":"#/components/schemas/IndexConfig"},"ef_search":{"type":"integer","minimum":1,"maximum":100000},"filter":{"type":["array","null"],"maxItems":64,"items":{"$ref":"#/components/schemas/Condition"}}}}}}},
        "responses": {
          "200": {"description": "Nearest hits, ordered by increasing metric distance then numeric ID. Inner-product distances may be negative.", "content": {"application/json": {"schema": {"type": "object", "required": ["hits"], "properties": {"hits": {"type": "array", "items": {"type": "object", "required": ["id", "distance"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "distance": {"type": "number"}}}}}}}}},
          "409": {"description": "index_not_ready in approximate_ready mode; explicitly build the index or choose another mode", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "413": {"$ref": "#/components/responses/TooLarge"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "415": {"$ref": "#/components/responses/MediaType"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/openapi.json": {
      "get": {"summary": "This OpenAPI contract", "responses": {"200": {"description": "OpenAPI 3.1 JSON document"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "description": "Random 32..256-character base64url credential. Admin: VLITE_AUTH_TOKEN or configured file. Optional distinct read-only: VLITE_READ_ONLY_TOKEN or configured file. Never put credentials in URLs or request bodies. See /v1/capabilities for effective role."}
    },
    "schemas": {
      "SearchRequest":{"type":"object","additionalProperties":false,"required":["vector","k"],"properties":{"vector":{"$ref":"#/components/schemas/Vector"},"k":{"type":"integer","minimum":0,"maximum":10000},"metric":{"enum":["squared_l2","cosine","inner_product"],"default":"squared_l2"},"mode":{"enum":["exact","approximate","approximate_ready"],"default":"exact"},"config":{"$ref":"#/components/schemas/IndexConfig"},"ef_search":{"type":"integer","minimum":1,"maximum":100000},"filter":{"type":["array","null"],"maxItems":64,"items":{"$ref":"#/components/schemas/Condition"}}}},
      "TokenStatus":{"type":"object","properties":{"generation":{"type":"integer"},"admin_file_configured":{"type":"boolean"},"read_only_configured":{"type":"boolean"},"read_only_file_configured":{"type":"boolean"}}},
      "IndexConfig":{"type":"object","additionalProperties":false,"properties":{"m":{"type":"integer","minimum":2,"maximum":64,"default":16},"ef_construction":{"type":"integer","minimum":2,"maximum":4096,"default":100,"description":"Must be >= m"},"seed":{"oneOf":[{"type":"integer","minimum":0,"maximum":18446744073709551615},{"type":"string","pattern":"^(0|[1-9][0-9]*)$"}],"default":42,"description":"Administrative responses use decimal string for JS precision"}}},
      "RebuildLimits":{"type":"object","additionalProperties":false,"properties":{"max_records":{"type":"integer","minimum":1,"maximum":1000000,"default":100000},"max_snapshot_vector_bytes":{"type":"integer","minimum":1,"maximum":268435456,"default":134217728}}},
      "RebuildRequest":{"type":"object","additionalProperties":false,"properties":{"config":{"$ref":"#/components/schemas/IndexConfig"},"metric":{"enum":["squared_l2","cosine"],"default":"squared_l2"},"limits":{"$ref":"#/components/schemas/RebuildLimits"}}},
      "RebuildOutcome":{"enum":["idle","running","cancelling","published","cancelled","superseded","catch_up_overflow"]},
      "BufferCapacity":{"type":"object","properties":{"buffered_ids":{"type":"integer"},"buffer_vector_bytes":{"type":"integer"},"remaining_ids":{"type":"integer"},"remaining_vector_bytes":{"type":"integer"}}},
      "MaintenancePolicy":{"type":"object","additionalProperties":false,"properties":{"config":{"$ref":"#/components/schemas/IndexConfig"},"metric":{"enum":["squared_l2","cosine"],"default":"squared_l2"},"limits":{"$ref":"#/components/schemas/RebuildLimits"},"rebuild_at_buffered_ids":{"type":"integer","minimum":1,"maximum":256,"default":128},"rebuild_at_buffer_vector_bytes":{"type":"integer","minimum":1,"maximum":8388608,"default":4194304}}},
      "MaintenanceStatus":{"type":"object","properties":{"ready":{"type":"boolean"},"pressure":{"enum":["healthy","rebuild_recommended","capacity_exhausted","unavailable","catch_up_overflow"]},"active_buffer":{"oneOf":[{"$ref":"#/components/schemas/BufferCapacity"},{"type":"null"}]},"rebuild":{"oneOf":[{"type":"null"},{"type":"object","properties":{"config":{"$ref":"#/components/schemas/IndexConfig"},"metric":{"enum":["squared_l2","cosine"]},"snapshot_records":{"type":"integer"},"processed_records":{"type":"integer"},"worker_finished":{"type":"boolean"},"terminal_reason":{"oneOf":[{"$ref":"#/components/schemas/RebuildOutcome"},{"type":"null"}]},"catchup_buffer":{"oneOf":[{"$ref":"#/components/schemas/BufferCapacity"},{"type":"null"}]}}}]}}},
      "MaintenanceEnvelope":{"type":"object","properties":{"policy":{"$ref":"#/components/schemas/MaintenancePolicy"},"status":{"$ref":"#/components/schemas/MaintenanceStatus"}}},
      "Inspection":{"type":"object","properties":{"format_version":{"type":"integer"},"dimensions":{"type":"integer"},"live_records":{"type":"integer"},"file_bytes":{"type":"integer"},"valid_bytes":{"type":"integer"},"incomplete_tail_bytes":{"type":"integer"}}},
      "SnapshotResult":{"type":"object","properties":{"name":{"type":"string"},"inspection":{"$ref":"#/components/schemas/Inspection"},"restart_required":{"const":true}}},
      "Metrics": {"type": "object", "required": ["requests_total", "request_failures_total", "unauthorized_total", "request_duration_seconds_total", "commit_failures_total", "hnsw_rebuilds_total", "hnsw_buffered_ids", "hnsw_buffer_vector_bytes", "hnsw_rebuild_and_search_seconds_total", "database_healthy", "database_bytes", "live_records"], "properties": {
        "requests_total": {"type": "integer", "minimum": 0},
        "request_failures_total": {"type": "integer", "minimum": 0},
        "unauthorized_total": {"type": "integer", "minimum": 0},
        "request_duration_seconds_total": {"type": "number", "minimum": 0},
        "commit_failures_total": {"type": "integer", "minimum": 0},
        "hnsw_rebuilds_total": {"type": "integer", "minimum": 0},
        "hnsw_buffered_ids": {"type": "integer", "minimum": 0, "maximum": 256},
        "hnsw_buffer_vector_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "hnsw_rebuild_and_search_seconds_total": {"type": "number", "minimum": 0},
        "database_healthy": {"type": "boolean"},
        "database_bytes": {"type": ["integer", "null"], "minimum": 32},
        "live_records": {"type": ["integer", "null"], "minimum": 0}
      }},
      "Id": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20, "description": "Canonical decimal u64, maximum 18446744073709551615; never a JSON number"},
      "Vector": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"type": "number", "format": "float"}, "description": "Finite f32 components, exactly the database's dimension count"},
      "Put": {"type": "object", "additionalProperties": false, "required": ["vector"], "properties": {"vector": {"$ref": "#/components/schemas/Vector"}, "payload_base64": {"type": "string", "contentEncoding": "base64", "default": "", "description": "Canonical padded standard base64, decoded length <=1048576 bytes"}, "metadata": {"$ref": "#/components/schemas/Metadata"}}},
      "Record": {"type": "object", "required": ["id", "vector", "payload_base64", "metadata"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "vector": {"$ref": "#/components/schemas/Vector"}, "payload_base64": {"type": "string", "contentEncoding": "base64"}, "metadata": {"$ref": "#/components/schemas/Metadata"}}},
      "BatchPut": {"type": "object", "additionalProperties": false, "required": ["op", "id", "vector"], "properties": {"op": {"const": "put"}, "id": {"$ref": "#/components/schemas/Id"}, "vector": {"$ref": "#/components/schemas/Vector"}, "payload_base64": {"type": "string", "contentEncoding": "base64", "default": ""}, "metadata": {"$ref": "#/components/schemas/Metadata"}}},
      "Metadata": {"type": "object", "maxProperties": 64, "default": {}, "description": "Full replacement map; keys 1..256 UTF-8 bytes, string values <=4096 UTF-8 bytes, encoded map <=65536 bytes. Nonempty metadata requires file format v3. No nulls, nesting or arrays.", "additionalProperties": {"$ref": "#/components/schemas/MetadataValue"}},
      "MetadataValue": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "string"}, "value": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "integer"}, "value": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$", "description": "Canonical decimal signed i64 string, range -9223372036854775808..9223372036854775807"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "float"}, "value": {"type": "number", "format": "double", "description": "Finite f64"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "boolean"}, "value": {"type": "boolean"}}}
      ]},
      "Condition": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "field", "value"], "properties": {"op": {"const": "eq"}, "field": {"type": "string", "description": "1..256 UTF-8 bytes, case-sensitive"}, "value": {"$ref": "#/components/schemas/MetadataValue"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "field"], "description": "At least one non-null min/max. Both bounds must be the same numeric type and min <= max; inclusive. String/boolean bounds are rejected.", "properties": {"op": {"const": "range"}, "field": {"type": "string"}, "min": {"anyOf": [{"$ref": "#/components/schemas/MetadataValue"}, {"type": "null"}]}, "max": {"anyOf": [{"$ref": "#/components/schemas/MetadataValue"}, {"type": "null"}]}}}
      ]},
      "BatchDelete": {"type": "object", "additionalProperties": false, "required": ["op", "id"], "properties": {"op": {"const": "delete"}, "id": {"$ref": "#/components/schemas/Id"}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}
    },
    "responses": {
      "Unauthorized": {"description": "Missing, invalid or duplicate bearer authorization header", "headers": {"WWW-Authenticate": {"schema": {"type": "string", "const": "Bearer"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Upgrade": {"description": "Nonempty batch requires v2+, nonempty metadata requires v3. Stop server and compact to a new current-version path; source is never upgraded in place.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "BadRequest": {"description": "Malformed JSON or invalid ID", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "Unknown route or record", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "TooLarge": {"description": "JSON body exceeds 8 MiB", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "MediaType": {"description": "Expected application/json", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InvalidInput": {"description": "Schema or database validation rejected input; no write", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unavailable": {"description": "Busy, closed, poisoned, or indeterminate commit. commit_indeterminate can mean the write succeeded. Do not blindly retry mutations.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
