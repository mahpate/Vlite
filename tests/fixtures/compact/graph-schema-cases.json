        "declarations": [{"kind": "Relationship", "name": "R", "description": "", "properties": [], "endpoints": [{"source": "A", "destination": "B"}], "multiplicity": "UniqueTriple"}],
        "nodes": [{"id": 0, "labels": ["A"], "properties": []}, {"id": 1, "labels": ["B"], "properties": []}],
        "edges": [
          {"id": 3, "source": 0, "relationship": "R", "destination": 0, "properties": []},
