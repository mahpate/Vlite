        {"id": 20, "public_id": "last", "source": 2, "target": 3, "relationship": "r", "weight": 1},
        {"id": 10, "public_id": "first", "source": 1, "target": 2, "relationship": "r", "weight": 1}
      ],
      "parameters": {"scope": {"seeds": [1], "max_hops": 2, "direction": "out", "node_labels": "any", "relationship_types": ["r"]}, "source": 1, "target": 3, "weight_policy": "explicit"},
      "expected": {"scope_node_ids": [1, 2, 3], "scope_edge_ids": [10, 20, 30], "output": {"status": "found", "path": {"cost": 2, "hops": 2, "edge_ids": [10, 20], "node_ids": [1, 2, 3]}}}
    },
