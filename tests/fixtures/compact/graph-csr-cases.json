        ],
        "relationships": ["r"], "labels": [],
        "edge_table": [
          {"id": 9007199254740993, "ordinal": 0, "source": 0, "target": 1, "relationship": 0},
          {"id": 18446744073709551615, "ordinal": 1, "source": 2, "target": 0, "relationship": 0}
        ],
        "out_csr": {"offsets": [0, 1, 1, 2], "neighbors": [0, 1]},
        "in_csr": {"offsets": [0, 1, 2, 2], "neighbors": [1, 0]},
        "adjacency": [
          [["r", 9007199254740993], ["r", 18446744073709551615]],
          [["r", 18446744073709551615]]
        ]
      }
    },
    {
      "name": "parallel-same",
      "purpose": "Distinct same-type parallel edges preserve edge-ID order rather than import order.",
      "nodes": [{"id": 20, "labels": []}, {"id": 10, "labels": []}],
      "edges": [
        {"id": 9, "source": 10, "target": 20, "relationship": "r"},
        {"id": 2, "source": 10, "target": 20, "relationship": "r", "deadline": null}
      ],
      "clock": 0,
      "queries": [
        {"node": 10, "direction": "out", "relationship": null, "after": null, "limit": 10},
        {"node": 20, "direction": "in", "relationship": null, "after": null, "limit": 10}
      ],
      "expected": {
        "node_map": [{"id": 10, "ordinal": 0, "labels": []}, {"id": 20, "ordinal": 1, "labels": []}],
        "relationships": ["r"], "labels": [],
        "edge_table": [
          {"id": 2, "ordinal": 0, "source": 0, "target": 1, "relationship": 0},
          {"id": 9, "ordinal": 1, "source": 0, "target": 1, "relationship": 0}
