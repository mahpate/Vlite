{
  "openapi": "3.1.0",
  "info": {
    "title": "VLite REST API",
    "version": "0.1.0",
    "description": "Experimental local/trusted-network API for one exclusively owned database. No authentication, TLS, CORS, automatic repair or retries. IDs are canonical decimal strings, payloads are padded standard base64. Requests are limited to 8 MiB of JSON and 16 in-flight requests/workers. Successful writes are synced. A disconnect or commit_indeterminate error does not prove a write failed; never blindly retry mutations. Database creation has the embedded engine's parent-directory durability limitations."
  },
  "servers": [{"url": "http://127.0.0.1:8080"}],
  "paths": {
    "/health": {
      "get": {
        "summary": "Process liveness, independent of database health",
        "responses": {"200": {"description": "Alive", "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"const": "ok"}}, "required": ["status"]}}}}}
      }
    },
    "/ready": {
      "get": {
        "summary": "Database can serve reads; poisoned/closed handles fail",
        "responses": {
          "200": {"description": "Ready", "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"const": "ready"}}, "required": ["status"]}}}},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/database": {
      "get": {
        "summary": "Database dimensions, format and live record count",
        "responses": {
          "200": {"description": "Database information", "content": {"application/json": {"schema": {"type": "object", "required": ["dimensions", "format_version", "records"], "properties": {"dimensions": {"type": "integer"}, "format_version": {"type": "integer"}, "records": {"type": "integer"}}}}}},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/vectors/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Id"}}],
      "get": {
        "summary": "Read one vector and opaque payload",
        "responses": {
          "200": {"description": "Record", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Record"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      },
      "put": {
        "summary": "Durably insert or replace vector and payload",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Put"}}}},
        "responses": {
          "204": {"description": "Durably committed"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "413": {"$ref": "#/components/responses/TooLarge"},
          "415": {"$ref": "#/components/responses/MediaType"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      },
      "delete": {
        "summary": "Durably delete; missing ID is a successful no-op",
        "responses": {
          "200": {"description": "Deletion result", "content": {"application/json": {"schema": {"type": "object", "required": ["deleted"], "properties": {"deleted": {"type": "boolean"}}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/batches": {
      "post": {
        "summary": "Durably apply all operations atomically in order",
        "description": "At most 4096 operations and 16 MiB encoded engine body, additionally bounded by the 8 MiB HTTP JSON limit. Empty batch is a no-op. Duplicate IDs execute in order. Any invalid operation rejects the entire batch before storage mutation.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["operations"], "properties": {"operations": {"type": "array", "maxItems": 4096, "items": {"oneOf": [{"$ref": "#/components/schemas/BatchPut"}, {"$ref": "#/components/schemas/BatchDelete"}]}}}}}}},
        "responses": {
          "204": {"description": "Entire batch durably committed, or empty no-op"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "409": {"description": "Nonempty batch on v1; stop service and compact to a new v2 path", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "413": {"$ref": "#/components/responses/TooLarge"},
          "415": {"$ref": "#/components/responses/MediaType"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/search": {
      "post": {
        "summary": "Exact squared-L2 search; distance then ascending numeric ID",
        "description": "k=0 returns no hits but still validates the query. k above the live count returns all records, up to the API k limit. Distances accumulate in f64. Payloads are fetched separately.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["vector", "k"], "properties": {"vector": {"$ref": "#/components/schemas/Vector"}, "k": {"type": "integer", "minimum": 0, "maximum": 10000}}}}}},
        "responses": {
          "200": {"description": "Nearest hits", "content": {"application/json": {"schema": {"type": "object", "required": ["hits"], "properties": {"hits": {"type": "array", "items": {"type": "object", "required": ["id", "distance"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "distance": {"type": "number", "minimum": 0}}}}}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "413": {"$ref": "#/components/responses/TooLarge"},
          "415": {"$ref": "#/components/responses/MediaType"},
          "422": {"$ref": "#/components/responses/InvalidInput"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/openapi.json": {
      "get": {"summary": "This OpenAPI contract", "responses": {"200": {"description": "OpenAPI 3.1 JSON document"}}}
    }
  },
  "components": {
    "schemas": {
      "Id": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20, "description": "Canonical decimal u64, maximum 18446744073709551615; never a JSON number"},
      "Vector": {"type": "array", "minItems": 1, "maxItems": 65536, "items": {"type": "number", "format": "float"}, "description": "Finite f32 components, exactly the database's dimension count"},
      "Put": {"type": "object", "additionalProperties": false, "required": ["vector"], "properties": {"vector": {"$ref": "#/components/schemas/Vector"}, "payload_base64": {"type": "string", "contentEncoding": "base64", "default": "", "description": "Canonical padded standard base64, decoded length <=1048576 bytes"}}},
      "Record": {"type": "object", "required": ["id", "vector", "payload_base64"], "properties": {"id": {"$ref": "#/components/schemas/Id"}, "vector": {"$ref": "#/components/schemas/Vector"}, "payload_base64": {"type": "string", "contentEncoding": "base64"}}},
      "BatchPut": {"type": "object", "additionalProperties": false, "required": ["op", "id", "vector"], "properties": {"op": {"const": "put"}, "id": {"$ref": "#/components/schemas/Id"}, "vector": {"$ref": "#/components/schemas/Vector"}, "payload_base64": {"type": "string", "contentEncoding": "base64", "default": ""}}},
      "BatchDelete": {"type": "object", "additionalProperties": false, "required": ["op", "id"], "properties": {"op": {"const": "delete"}, "id": {"$ref": "#/components/schemas/Id"}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}
    },
    "responses": {
      "BadRequest": {"description": "Malformed JSON or invalid ID", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "Unknown route or record", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "TooLarge": {"description": "JSON body exceeds 8 MiB", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "MediaType": {"description": "Expected application/json", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InvalidInput": {"description": "Schema or database validation rejected input; no write", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unavailable": {"description": "Busy, closed, poisoned, or indeterminate commit. commit_indeterminate can mean the write succeeded. Do not blindly retry mutations.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
