{
  "schema": "vlite.compact-graph-schema-logical",
  "version": 1,
  "cases": [
    {
      "name": "empty-schema-empty-snapshot",
      "purpose": "An empty declaration removes all rules; empty arrays are valid.",
      "input": {"declarations": [], "nodes": [], "edges": [], "queries": []},
      "expected": {"declarations": [], "conforms": true, "violations": [], "results": []}
    },
    {
      "name": "empty-schema-open-world",
      "purpose": "Undeclared types and parallel edges are allowed; Eq preserves Boolean/Integer/Float identity.",
      "input": {
        "declarations": [],
        "nodes": [
          {"id": 2, "labels": ["Free", "Free"], "properties": [{"name": "p", "type": "Boolean", "value": true}]},
          {"id": 0, "labels": [], "properties": [{"name": "p", "type": "Integer", "value": 1}]},
          {"id": 1, "labels": ["Free"], "properties": [{"name": "p", "type": "Float", "bits": "3ff0000000000000"}]}
        ],
        "edges": [
          {"id": 1, "source": 0, "relationship": "UNKNOWN", "destination": 1, "properties": []},
          {"id": 0, "source": 0, "relationship": "UNKNOWN", "destination": 1, "properties": []}
        ],
        "queries": [
          {"label": null, "op": "Eq", "property": "p", "value": {"type": "Integer", "value": 1}},
          {"label": "Free", "op": "Eq", "property": "p", "value": {"type": "Boolean", "value": true}},
          {"label": null, "op": "Eq", "property": "p", "value": {"type": "Float", "bits": "3ff0000000000000"}}
        ]
      },
      "expected": {
        "declarations": [], "conforms": true, "violations": [],
        "results": [{"ids": [0], "index": "Scan"}, {"ids": [2], "index": "Scan"}, {"ids": [1], "index": "Scan"}]
      }
    },
    {
      "name": "canonical-declaration-order-and-separate-namespaces",
      "purpose": "Both declaration kinds may share a name. Descriptions, all flags and undeclared endpoint labels survive canonical ordering.",
      "input": {
        "declarations": [
          {"kind": "Relationship", "name": "Same", "description": "Directed \u00e9", "properties": [
            {"name": "\u00e9", "type": "String", "required": false, "unique": false, "index": null},
            {"name": " a.-", "type": "Boolean", "required": true, "unique": false, "index": null}
          ], "endpoints": [{"source": "Z", "destination": "A"}, {"source": "A", "destination": "Z"}, {"source": "A", "destination": "A"}], "multiplicity": "Multi"},
          {"kind": "Label", "name": "Same", "description": "", "properties": [
            {"name": "z", "type": "Float", "required": false, "unique": true, "index": "Range"},
            {"name": "a", "type": "GeoPoint", "required": true, "unique": false, "index": "Exact"}
          ]},
          {"kind": "Label", "name": "9_R", "description": "Leading digit is valid.", "properties": []}
        ],
        "nodes": [], "edges": [], "queries": []
      },
      "expected": {
        "declarations": [
          {"kind": "Label", "name": "9_R", "description": "Leading digit is valid.", "properties": []},
          {"kind": "Label", "name": "Same", "description": "", "properties": [
            {"name": "a", "type": "GeoPoint", "required": true, "unique": false, "index": "Exact"},
            {"name": "z", "type": "Float", "required": false, "unique": true, "index": "Range"}
          ]},
          {"kind": "Relationship", "name": "Same", "description": "Directed \u00e9", "properties": [
            {"name": " a.-", "type": "Boolean", "required": true, "unique": false, "index": null},
            {"name": "\u00e9", "type": "String", "required": false, "unique": false, "index": null}
          ], "endpoints": [{"source": "A", "destination": "A"}, {"source": "A", "destination": "Z"}, {"source": "Z", "destination": "A"}], "multiplicity": "Multi"}
        ],
        "conforms": true, "violations": [], "results": []
      }
    },
    {
      "name": "person-schema-conformance-and-index-choices",
      "purpose": "Required unique String, optional range Integer and directed UniqueTriple relationship follow the engine test schema.",
      "input": {
        "declarations": [
          {"kind": "Relationship", "name": "KNOWS", "description": "Acquaintance.", "properties": [
            {"name": "since", "type": "Integer", "required": false, "unique": false, "index": null}
          ], "endpoints": [{"source": "Person", "destination": "Person"}], "multiplicity": "UniqueTriple"},
          {"kind": "Label", "name": "Person", "description": "A human being.", "properties": [
            {"name": "name", "type": "String", "required": true, "unique": true, "index": null},
            {"name": "age", "type": "Integer", "required": false, "unique": false, "index": "Range"}
          ]}
        ],
        "nodes": [
          {"id": 7, "labels": ["Person"], "properties": [{"name": "name", "type": "String", "value": "Bob"}]},
          {"id": 2, "labels": ["Person"], "properties": [{"name": "age", "type": "Integer", "value": 36}, {"name": "name", "type": "String", "value": "Ada"}]},
          {"id": 9, "labels": ["Other"], "properties": [{"name": "age", "type": "String", "value": "unconstrained"}]}
        ],
        "edges": [{"id": 4, "source": 2, "relationship": "KNOWS", "destination": 7, "properties": [{"name": "since", "type": "Integer", "value": 2020}]}],
        "queries": [
          {"label": "Person", "op": "Eq", "property": "name", "value": {"type": "String", "value": "Bob"}},
          {"label": "Person", "op": "Range", "property": "age", "min": {"type": "Integer", "value": 36}, "max": {"type": "Integer", "value": 36}},
          {"label": "Person", "op": "Eq", "property": "age", "value": {"type": "Integer", "value": 36}},
          {"label": "Person", "op": "Range", "property": "age", "min": {"type": "Float", "bits": "0000000000000000"}, "max": null},
          {"label": "Absent", "op": "Eq", "property": "name", "value": {"type": "String", "value": "Bob"}}
        ]
      },
      "expected": {
        "declarations": [
          {"kind": "Label", "name": "Person", "description": "A human being.", "properties": [
            {"name": "age", "type": "Integer", "required": false, "unique": false, "index": "Range"},
            {"name": "name", "type": "String", "required": true, "unique": true, "index": null}
          ]},
          {"kind": "Relationship", "name": "KNOWS", "description": "Acquaintance.", "properties": [
            {"name": "since", "type": "Integer", "required": false, "unique": false, "index": null}
          ], "endpoints": [{"source": "Person", "destination": "Person"}], "multiplicity": "UniqueTriple"}
        ],
        "conforms": true, "violations": [],
        "results": [{"ids": [7], "index": "Exact"}, {"ids": [2], "index": "Range"}, {"ids": [2], "index": "Scan"}, {"ids": [], "index": "Range"}, {"ids": [], "index": "Scan"}]
      }
    },
    {
      "name": "all-five-types-and-u64-i64-boundaries",
      "purpose": "Typed equality normalizes signed zeros without numeric coercion; range is inclusive and keeps full i64 precision.",
      "input": {
        "declarations": [
          {"kind": "Label", "name": "Item", "description": "Typed.", "properties": [
            {"name": "s", "type": "String", "required": false, "unique": false, "index": "Exact"},
            {"name": "i", "type": "Integer", "required": false, "unique": true, "index": "Range"},
            {"name": "g", "type": "GeoPoint", "required": false, "unique": false, "index": "Exact"},
            {"name": "f", "type": "Float", "required": false, "unique": false, "index": "Exact"},
            {"name": "b", "type": "Boolean", "required": false, "unique": false, "index": "Exact"}
          ]}
        ],
        "nodes": [
          {"id": 18446744073709551615, "labels": ["Item"], "properties": [
            {"name": "b", "type": "Boolean", "value": false},
            {"name": "f", "type": "Float", "bits": "0000000000000000"},
            {"name": "g", "type": "GeoPoint", "latitude_bits": "8000000000000000", "longitude_bits": "0000000000000000"},
            {"name": "i", "type": "Integer", "value": 9223372036854775807},
            {"name": "s", "type": "String", "value": "text"}
          ]},
          {"id": 0, "labels": ["Item"], "properties": [
            {"name": "b", "type": "Boolean", "value": true},
            {"name": "f", "type": "Float", "bits": "8000000000000000"},
            {"name": "g", "type": "GeoPoint", "latitude_bits": "4056800000000000", "longitude_bits": "c066800000000000"},
            {"name": "i", "type": "Integer", "value": -9223372036854775808},
            {"name": "s", "type": "String", "value": ""}
          ]}
        ],
        "edges": [],
        "queries": [
          {"label": "Item", "op": "Eq", "property": "f", "value": {"type": "Float", "bits": "8000000000000000"}},
          {"label": "Item", "op": "Eq", "property": "b", "value": {"type": "Integer", "value": 1}},
          {"label": "Item", "op": "Eq", "property": "b", "value": {"type": "Boolean", "value": true}},
          {"label": "Item", "op": "Eq", "property": "g", "value": {"type": "GeoPoint", "latitude_bits": "0000000000000000", "longitude_bits": "8000000000000000"}},
          {"label": "Item", "op": "Range", "property": "i", "min": {"type": "Integer", "value": 9223372036854775807}, "max": null},
          {"label": "Item", "op": "Range", "property": "i", "min": null, "max": {"type": "Integer", "value": -9223372036854775808}},
          {"label": "Item", "op": "Eq", "property": "i", "value": {"type": "Integer", "value": 9223372036854775807}},
          {"label": "Item", "op": "Eq", "property": "s", "value": {"type": "String", "value": ""}}
        ]
      },
      "expected": {
        "declarations": [
          {"kind": "Label", "name": "Item", "description": "Typed.", "properties": [
            {"name": "b", "type": "Boolean", "required": false, "unique": false, "index": "Exact"},
            {"name": "f", "type": "Float", "required": false, "unique": false, "index": "Exact"},
            {"name": "g", "type": "GeoPoint", "required": false, "unique": false, "index": "Exact"},
            {"name": "i", "type": "Integer", "required": false, "unique": true, "index": "Range"},
            {"name": "s", "type": "String", "required": false, "unique": false, "index": "Exact"}
          ]}
        ],
        "conforms": true, "violations": [],
        "results": [{"ids": [0, 18446744073709551615], "index": "Exact"}, {"ids": [], "index": "Exact"}, {"ids": [0], "index": "Exact"}, {"ids": [18446744073709551615], "index": "Exact"}, {"ids": [18446744073709551615], "index": "Range"}, {"ids": [0], "index": "Range"}, {"ids": [18446744073709551615], "index": "Exact"}, {"ids": [0], "index": "Exact"}]
      }
    },
    {
      "name": "float-adjacent-values-subnormal-and-range-zero",
      "purpose": "No epsilon equality; the smallest positive subnormal is greater than zero. Signed zeros share inclusive numeric range postings.",
      "input": {
        "declarations": [{"kind": "Label", "name": "F", "description": "", "properties": [
          {"name": "p", "type": "Float", "required": false, "unique": true, "index": "Range"}
        ]}],
        "nodes": [
          {"id": 5, "labels": ["F"], "properties": [{"name": "p", "type": "Float", "bits": "3ff0000000000001"}]},
          {"id": 3, "labels": ["F"], "properties": [{"name": "p", "type": "Float", "bits": "3ff0000000000000"}]},
          {"id": 2, "labels": ["F"], "properties": [{"name": "p", "type": "Float", "bits": "0000000000000001"}]},
          {"id": 0, "labels": ["F"], "properties": [{"name": "p", "type": "Float", "bits": "8000000000000000"}]}
        ],
        "edges": [],
        "queries": [
          {"label": "F", "op": "Eq", "property": "p", "value": {"type": "Float", "bits": "3ff0000000000000"}},
          {"label": "F", "op": "Range", "property": "p", "min": {"type": "Float", "bits": "0000000000000000"}, "max": {"type": "Float", "bits": "8000000000000000"}},
          {"label": "F", "op": "Range", "property": "p", "min": {"type": "Float", "bits": "0000000000000001"}, "max": {"type": "Float", "bits": "3ff0000000000000"}}
        ]
      },
      "expected": {
        "declarations": [{"kind": "Label", "name": "F", "description": "", "properties": [
          {"name": "p", "type": "Float", "required": false, "unique": true, "index": "Range"}
        ]}], "conforms": true, "violations": [],
        "results": [{"ids": [3], "index": "Exact"}, {"ids": [0], "index": "Range"}, {"ids": [2, 3], "index": "Range"}]
      }
    },
    {
      "name": "missing-and-wrong-typed-required-properties",
      "purpose": "A well-formed snapshot can violate required/type rules without being malformed.",
      "input": {
        "declarations": [{"kind": "Label", "name": "L", "description": "", "properties": [
          {"name": "p", "type": "Integer", "required": true, "unique": false, "index": null}
        ]}],
        "nodes": [
          {"id": 1, "labels": ["L"], "properties": [{"name": "p", "type": "Boolean", "value": true}]},
          {"id": 0, "labels": ["L"], "properties": []}
