          {"id": 3, "ordinal": 2, "source": 0, "target": 1, "relationship": 3},
          {"id": 4, "ordinal": 3, "source": 0, "target": 1, "relationship": 0},
          {"id": 5, "ordinal": 4, "source": 0, "target": 1, "relationship": 1}
        ],
        "out_csr": {"offsets": [0, 5, 5], "neighbors": [3, 4, 1, 2, 0]},
        "in_csr": {"offsets": [0, 0, 5], "neighbors": [3, 4, 1, 2, 0]},
        "adjacency": [
          [["e\u0301", 4], ["z", 5], ["\u00e9", 2], ["\u4e2d", 3], ["\ud83d\ude00", 1]],
          [["\ud83d\ude00", 1]]
        ]
      }
