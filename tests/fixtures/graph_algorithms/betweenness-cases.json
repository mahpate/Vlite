{
  "schema": "vlite.graph-betweenness-golden",
  "version": 1,
  "contract": {
    "description": "Independent tiny exact-rational unweighted Brandes goldens for docs/projects/roadmap/gap5-graph-algorithms.md Centrality; no Rust engine is imported. Out uses stored arcs, In reverses them, Both is symmetric. Parallel arcs collapse, self-loops disappear, expired nodes hide incident edges, and expired edges hide only themselves.",
    "ordering": "Node rows ascend by numeric u64 ID. Selected and completed sources retain ascending (SplitMix64-v1(seed XOR node_id), node_id) rank, not node-ID order. Physical insertion order has no effect.",
    "arithmetic": "All sigma, dependencies, sums and normalization use fractions.Fraction. exact is canonical p/q including /1. f64_hex and f64_repr are float(Fraction).hex() and repr(float(Fraction)), not stepwise f64 engine reductions. For n>2 and k>0 score=(n/k)*raw_sum/((n-1)*(n-2)); Both has no additional /2. For n<=2 and k>0 scores are zero; k=0 takes precedence and scores is null.",
    "interruption": "interrupt_after_sources limits committed whole sources to a prefix of selected; an interrupted next source is discarded entirely. k=completed count. k=0 is no_scores; k=n>0 is exact; k=min(samples,n)<n is complete_estimated; otherwise partial_estimated.",
    "exclusions": "At most eight input nodes and 32 physical edges; sparse numeric IDs are supported. Expiration is an explicit snapshot flag, not a TTL clock, storage, authorization, work-budget or deadline integration test. No confidence intervals or binary64 overflow claims."
  },
  "splitmix64_vectors": [
    {"input": 0, "output": "0xe220a8397b1dcdaf"},
    {"input": 1, "output": "0x910a2dec89025cc1"},
    {"input": 2, "output": "0x975835de1c9756ce"},
    {"input": 3, "output": "0x1d0b14e4db018fed"},
    {"input": 4, "output": "0x6e73e372e2338aca"},
    {"input": 5, "output": "0x63033b0ca389c35a"},
    {"input": 18446744073709551615, "output": "0xe4d971771b652c20"}
  ],
  "cases": [
