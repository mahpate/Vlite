          {"id": 2, "labels": ["A"], "properties": [{"name": "p", "type": "String", "value": "same"}]},
          {"id": 1, "labels": ["A"], "properties": []},
          {"id": 0, "labels": ["A"], "properties": []}
        ], "edges": [],
