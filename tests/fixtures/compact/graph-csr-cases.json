        "in_csr": {"offsets": [0, 0], "neighbors": []}, "adjacency": [[], []]
      }
    },
    {
      "name": "large-ids",
      "purpose": "Exact sparse u64 IDs above 2^53 and at u64::MAX, never indexed by maximum ID.",
      "nodes": [
        {"id": 18446744073709551615, "labels": []},
        {"id": 9007199254740993, "labels": []},
        {"id": 0, "labels": []}
      ],
      "edges": [
        {"id": 18446744073709551615, "source": 18446744073709551615, "target": 0, "relationship": "r"},
        {"id": 9007199254740993, "source": 0, "target": 9007199254740993, "relationship": "r"}
      ],
      "clock": 0,
      "queries": [
        {"node": 0, "direction": "both", "relationship": null, "after": null, "limit": 10},
        {"node": 0, "direction": "both", "relationship": null,
         "after": {"relationship": "r", "edge": 9007199254740993}, "limit": 10}
      ],
      "expected": {
        "node_map": [
          {"id": 0, "ordinal": 0, "labels": []},
          {"id": 9007199254740993, "ordinal": 1, "labels": []},
